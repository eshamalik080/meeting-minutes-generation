# Copy this file to .env and adjust as needed. .env is gitignored.

# Set to "false" once the teammate's real ML pipeline functions are wired in
# to backend/ml_pipeline/. See ML_INTEGRATION.md at the repo root.
USE_MOCK_ML=true

# Only needed when USE_MOCK_ML=false — a HuggingFace access token with the
# pyannote/speaker-diarization-3.1 gated model's terms accepted. See
# ML_INTEGRATION.md.
# HF_TOKEN=

# Comma-separated list of origins allowed to call this API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded media and generated exports are stored on disk.
STORAGE_DIR=./storage

# Max upload size in megabytes.
MAX_UPLOAD_MB=500

# Secret used to sign auth JWTs (backend/app/auth/). Change this to a long
# random string before any real deployment — the default is only safe for
# local dev. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
