# Copy to .env.local (gitignored) to override.
# Not needed for local dev by default — Vite proxies /api/* to the backend
# (see vite.config.ts), so the app works against http://127.0.0.1:8000
# without any env vars set.

# Base URL for the backend API. Leave unset to use the /api proxy in dev.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# In production (e.g. Vercel), there is no dev proxy, so this must be set
# to the deployed backend's full URL, no trailing slash:
# VITE_API_BASE_URL=https://meeting-minutes-backend.onrender.com
